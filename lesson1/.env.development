# Development Environment Variables
NODE_ENV=development
PORT=3000
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://postgres:password@postgres:5432/nestjs_db
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=nestjs_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Keycloak Configuration
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=nestjs-dev
KEYCLOAK_CLIENT_ID=nestjs-app
KEYCLOAK_CLIENT_SECRET=nestjs-dev-secret

# RabbitMQ Configuration
RABBITMQ_URL=amqp://dev:dev123@rabbitmq:5672/dev
RABBITMQ_EXCHANGE=nestjs.events.exchange
RABBITMQ_QUEUE=nestjs.events

# MinIO Configuration
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=devadmin
MINIO_SECRET_KEY=dev123456
MINIO_BUCKET=nestjs-dev-bucket
MINIO_USE_SSL=false

# API Configuration
API_PREFIX=api/v1
API_VERSION=1.0.0

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# Email (Development)
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@nestjs-dev.local

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# External Services
GITLAB_URL=http://gitlab-dev.local:8082
JENKINS_URL=http://jenkins:8081
NEXUS_URL=http://nexus:8083
MINIO_SECRET_KEY=dev123456
MINIO_BUCKET=nestjs-dev-bucket
MINIO_USE_SSL=false

# JWT Configuration
JWT_SECRET=dev-secret-key-not-for-production
JWT_EXPIRES_IN=24h

# Application Configuration
API_PREFIX=api
API_VERSION=v1

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
