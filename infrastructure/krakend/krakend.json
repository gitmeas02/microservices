{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "DevOps Infrastructure API Gateway",
  "timeout": "5000ms",
  "cache_ttl": "300s",
  "output_encoding": "json",
  "port": 8000,
  "host": ["http://localhost:8000"],
  "debug_endpoint": true,
  "echo_endpoint": true,
  "extra_config": {
    "telemetry/metrics": {
      "collection_time": "60s",
      "proxy_disabled": false,
      "router_disabled": false,
      "backend_disabled": false,
      "endpoint_disabled": false,
      "listen_address": ":8090"
    },
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true,
      "format": "default"
    },
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "HEAD", "POST", "PUT", "DELETE", "CONNECT", "OPTIONS", "TRACE", "PATCH"],
      "allow_headers": ["Accept-Language", "Authorization", "Content-Type", "X-Requested-With", "X-API-Key"],
      "expose_headers": ["Content-Length", "X-Request-Id"],
      "max_age": "12h",
      "allow_credentials": true,
      "debug": false
    },
    "router": {
      "return_error_msg": true
    }
  },
  "endpoints": [
    {
      "endpoint": "/health",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/__health",
          "encoding": "json",
          "method": "GET",
          "host": ["http://localhost:8000"],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/api/v1/health",
      "method": "GET",
      "output_encoding": "json",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "json",
          "method": "GET",
          "host": ["http://nestjs-app:3000"],
          "disable_host_sanitize": false,
          "extra_config": {
            "backend/http": {
              "return_error_details": "backend_alias"
            }
          }
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/realms/{realm}/protocol/openid_connect/{path}",
      "method": "GET",
      "output_encoding": "json",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 50,
          "client_max_rate": 5,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/realms/{realm}/protocol/openid_connect/{path}",
          "encoding": "json",
          "method": "GET",
          "host": ["http://keycloak:8080"],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/realms/{realm}/protocol/openid_connect/token",
      "method": "POST",
      "output_encoding": "json",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 30,
          "client_max_rate": 3,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/realms/{realm}/protocol/openid_connect/token",
          "encoding": "json",
          "method": "POST",
          "host": ["http://keycloak:8080"],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/api/v1/monitoring/metrics/query",
      "method": "GET",
      "output_encoding": "string",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 200,
          "client_max_rate": 20,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/query",
          "encoding": "string",
          "method": "GET",
          "host": ["http://prometheus:9090"],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/api/v1/messaging/queues",
      "method": "GET",
      "output_encoding": "json",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 50,
          "client_max_rate": 5,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/queues",
          "encoding": "json",
          "method": "GET",
          "host": ["http://rabbitmq:15672"],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/api/v1/artifacts/repositories",
      "method": "GET",
      "output_encoding": "json",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/service/rest/v1/repositories",
          "encoding": "json",
          "method": "GET",
          "host": ["http://nexus:8081"],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/api/v1/dashboards/search",
      "method": "GET",
      "output_encoding": "json",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/search",
          "encoding": "json",
          "method": "GET",
          "host": ["http://grafana:3000"],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/api/v1/gateway/status",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/__health",
          "encoding": "json",
          "method": "GET",
          "host": ["http://localhost:8000"],
          "disable_host_sanitize": false
        }
      ]
    }
  ]
}
